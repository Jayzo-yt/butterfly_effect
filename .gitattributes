# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

# Generated/large data: keep diffs out of review, they are machine-written.
data/city/*.json linguist-generated=true
frontend/package-lock.json linguist-generated=true

# GitHub language stats should reflect the engine, not the data.
data/** linguist-detectable=false

# Images are binary. `text=auto` detects this, but say so explicitly: line-ending
# normalisation on a PNG corrupts it silently.
*.png binary
*.jpg binary
*.svg text
